# MeP-c5 with the IVC2 coprocessor (Venezia), big-endian: every core option, IVC2 core-mode
# instructions and the VLIW operation mode

@define ENDIAN "big"

define endian=$(ENDIAN);
define alignment=2;

@define DIV_OPT 1
@define MUL_OPT 1
@define BIT_OPT 1
@define SAT_OPT 1
@define CLP_OPT 1
@define MIN_OPT 1
@define AVE_OPT 1
@define ABS_OPT 1
@define LDZ_OPT 1
@define DBG_OPT 1
@define UCI_OPT 1
@define DSP_OPT 1
@define COP_OPT 1
@define IVC2_OPT 1

@include "MeP-c5.sinc"
