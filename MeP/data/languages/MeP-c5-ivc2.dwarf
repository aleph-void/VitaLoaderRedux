<dwarf>
	<!-- GCC's MeP register numbers (DBX_REGISTER_NUMBER is the identity): 0-15 general
	     registers, 16-47 control registers, 48-79 coprocessor registers, 80-111 coprocessor
	     control registers; IVC2 languages name ccr0-ccr15 as IVC2 does -->
	<register_mappings>
		<register_mapping dwarf="0" ghidra="r0" auto_count="13"/>
		<register_mapping dwarf="13" ghidra="tp"/>
		<register_mapping dwarf="14" ghidra="gp"/>
		<register_mapping dwarf="15" ghidra="sp" stackpointer="true"/>
		<register_mapping dwarf="16" ghidra="pc"/>
		<register_mapping dwarf="17" ghidra="lp"/>
		<register_mapping dwarf="18" ghidra="sar"/>
		<register_mapping dwarf="20" ghidra="rpb"/>
		<register_mapping dwarf="21" ghidra="rpe"/>
		<register_mapping dwarf="22" ghidra="rpc"/>
		<register_mapping dwarf="23" ghidra="hi"/>
		<register_mapping dwarf="24" ghidra="lo"/>
		<register_mapping dwarf="28" ghidra="mb0"/>
		<register_mapping dwarf="29" ghidra="me0"/>
		<register_mapping dwarf="30" ghidra="mb1"/>
		<register_mapping dwarf="31" ghidra="me1"/>
		<register_mapping dwarf="32" ghidra="psw"/>
		<register_mapping dwarf="35" ghidra="epc"/>
		<register_mapping dwarf="36" ghidra="exc"/>
		<register_mapping dwarf="48" ghidra="c0" auto_count="32"/>
		<register_mapping dwarf="80" ghidra="csar0"/>
		<register_mapping dwarf="81" ghidra="cc"/>
		<register_mapping dwarf="82" ghidra="ccr2"/>
		<register_mapping dwarf="83" ghidra="ccr3"/>
		<register_mapping dwarf="84" ghidra="cofr0"/>
		<register_mapping dwarf="85" ghidra="cofr1"/>
		<register_mapping dwarf="86" ghidra="cofa0"/>
		<register_mapping dwarf="87" ghidra="cofa1"/>
		<register_mapping dwarf="88" ghidra="ccr8" auto_count="7"/>
		<register_mapping dwarf="95" ghidra="csar1"/>
		<register_mapping dwarf="96" ghidra="ccr16" auto_count="16"/>
	</register_mappings>
	<call_frame_cfa value="0"/>
</dwarf>
