# Toshiba MeP (Media embedded Processor) core instruction set, MeP-c4 and MeP-c5.
#
# Originally written by CreepNT for VitaLoader Redux (CMeP, MeP-c4 with PREF and CACHE);
# rebuilt by Ghidra-Rare: every core instruction GNU binutils knows for the MeP-c5 machine,
# coprocessor loads/stores incl. modulo addressing, control-bus and c5 instructions,
# corrected semantics. See CREDITS.md.
#
# Main slaspec must define the following things:
#  * endianess
#  * alignment
#  * the ENDIAN macro (either "little" or "big")
#
# Main slaspec may optionally define the following macros as 1 to enable MeP core options:
#
#   MUL_OPT: The 32-bit Multiply instruction option is ON.
#   DIV_OPT: The 32-bit divide instruction option is ON.
#   BIT_OPT: The bit manipulation instruction option is ON (incl. c5 CASB3/CASH3/CASW3).
#   LDZ_OPT: The leading zero option is ON.
#   ABS_OPT: The absolute difference instruction option is ON.
#   AVE_OPT: The average instruction option is ON.
#   MIN_OPT: The MIN/MAX instruction option is ON.
#   CLP_OPT: The clip instruction option is ON.
#   SAT_OPT: The saturation instruction option is ON.
#   DBG_OPT: The debug support function is ON.
#   UCI_OPT: The User Custom Instruction option is ON.
#   DSP_OPT: The DSP option is ON.
#   COP_OPT: The coprocessor option is ON (coprocessor loads/stores, BCPxx, SYNCCP, JSRV/BSRV).
#   IVC2_OPT: the IVC2 (Venezia) coprocessor; the slaspec includes ivc2.sinc, which
#             defines the CP instruction and the VLIW operation mode.
#
# Instructions of a disabled option do not decode (the core raises a reserved-instruction
# exception for them).

#Ensure all non-provided macros are defined as 0.
@include "Options.sinc"

define space ram type=ram_space size=4 wordsize=1 default;
# Control bus (STCB/LDCB): word-addressed in the instructions, byte-addressed here
# (control-bus address n is cbus:4*n).
define space cbus type=ram_space size=4 wordsize=1;
define space register type=register_space size=4;

#General-purpose registers
define register offset=0x0 size=4 [
	r0	r1	r2	r3	r4	r5	r6  r7
	r8	r9	r10 r11 r12	tp  gp  sp
];

#Control registers, in control-register-number order (STC/LDC operand).
#csr3, csr9-11 and csr29-31 are reserved.
@define CREG_OFFSET 		0x10000

define register offset=$(CREG_OFFSET) size=4 [
	pc    lp    sar   csr3  rpb   rpe   rpc   hi
	lo    csr9  csr10 csr11 mb0   me0   mb1   me1
	psw   id    tmp   epc   exc   cfg   vid   npc
	dbg   depc  opt   rcfg  ccfg  csr29 csr30 csr31
];

#Co-processor registers
#Assume registers are 64-bit regardless of actual size (can be 32)

@define CP_OFFSET 0x18000
@define CP_CREG_OFFSET 0x18200

define register offset=$(CP_OFFSET) size=8 [
	c0	c1	c2	c3	c4	c5	c6	c7
	c8	c9	c10	c11	c12	c13	c14	c15
	c16 c17 c18 c19 c20 c21 c22 c23
	c24 c25 c26 c27 c28 c29 c30 c31
];
#Low 32 bits of c0-c15 (32-bit coprocessor transfers)
@if ENDIAN == "big"
define register offset=$(CP_OFFSET) size=4 [
	_ c0l _ c1l _ c2l _ c3l _ c4l _ c5l _ c6l _ c7l
	_ c8l _ c9l _ c10l _ c11l _ c12l _ c13l _ c14l _ c15l
];
@else
define register offset=$(CP_OFFSET) size=4 [
	c0l _ c1l _ c2l _ c3l _ c4l _ c5l _ c6l _ c7l _
	c8l _ c9l _ c10l _ c11l _ c12l _ c13l _ c14l _ c15l _
];
@endif

#Coprocessor control registers (CCR1 is the coprocessor branch condition, cp_flag)
define register offset=$(CP_CREG_OFFSET) size=4 [
@if IVC2_OPT == "1"
	csar0 cc    ccr2  ccr3  cofr0 cofr1 cofa0 cofa1
	ccr8  ccr9  ccr10 ccr11 ccr12 ccr13 ccr14 csar1
@else
	ccr0  ccr1  ccr2  ccr3  ccr4  ccr5  ccr6  ccr7
	ccr8  ccr9  ccr10 ccr11 ccr12 ccr13 ccr14 ccr15
@endif
	ccr16 ccr17 ccr18 ccr19 ccr20 ccr21 ccr22 ccr23
	ccr24 ccr25 ccr26 ccr27 ccr28 ccr29 ccr30 ccr31
	ccr32 ccr33 ccr34 ccr35 ccr36 ccr37 ccr38 ccr39
	ccr40 ccr41 ccr42 ccr43 ccr44 ccr45 ccr46 ccr47
	ccr48 ccr49 ccr50 ccr51 ccr52 ccr53 ccr54 ccr55
	ccr56 ccr57 ccr58 ccr59 ccr60 ccr61 ccr62 ccr63
];

@if IVC2_OPT == "1"
@define CP_FLAG "cc"
@else
@define CP_FLAG "ccr1"
@endif

#Repeat-block branch decision, taken at the second-to-last instruction of the block
define register offset=0x19000 size=1 [ rpt ];

# Context register
@define CONTEXTREG_OFFSET 0x19FF8
@if IVC2_OPT == "1"
define register offset=$(CONTEXTREG_OFFSET) size=16 contextreg;
@else
define register offset=$(CONTEXTREG_OFFSET) size=8 contextreg;
@endif
define context contextreg
	ELR=(0,0) noflow
	#Operation mode: 0 core, 1 VLIW (IVC2 languages)
	OM=(12,12)
	#Set while the core instruction of a VLIW bundle is decoded
	INVLIW=(13,13) noflow
	#Set on the instruction after "stc $12,$lp" (GCC's mode-switching sibling call)
	SIBJ=(14,14) noflow

	#Number of instructions remaining, including the
	#one marked, in REPEAT/EREPEAT block (either 2 or 1)
	REPEAT_REMAINING=(28,29) noflow

	#Target of a REPEAT/EREPEAT jump
	REPEAT_START=(32,63) noflow
@if IVC2_OPT == "1"
	#IVC2 bundle slots while a bundle is decoded: P0S or P0 (IVA), P1 (IVB)
	IVA=(64,91) noflow
	IVB=(96,123) noflow
@include "ivc2_ctx.sinc"
@endif
;

#16-bit instruction,
#or first part of 32-bit instructions
define token instr (16)
	major=(12,15)
	sub=(0,3)
	sub3=(0,2)
	sub2=(0,1)

	Rn07=(8,10)
	CRn=(8,11)
	CRn32=(8,11)
	CRn64=(8,11)
	Rn=(8,11)
	Rm=(4,7)
	RmA=(4,7)
	Rl=(0,3)

	cccc=(4,7)

	op0000=(0,0)
	op0303=(3,3)
	op0103=(1,3)
	op0407=(4,7)
	op0507=(5,7)
	op0611=(6,11)
	op0707=(7,7)
	op0811=(8,11)
	op1011=(10,11)
	op1111=(11,11)
	op0810=(8,10)

	imm0006=(0,6)
	imm0007=(0,7)
	imm0106=(1,6)
	imm0206=(2,6)
	imm0207=(2,7)
	imm0307=(3,7)
	imm0405=(4,5)
	imm0407=(4,7)
	imm0410=(4,10)
	imm0809=(8,9)
	imm0810=(8,10)
	imm0811=(8,11)

	simm0007=(0,7) signed
	simm0107=(1,7) signed
	simm0207=(2,7) signed
	simm0111=(1,11) signed
@if IVC2_OPT == "1"
@include "ivc2_instr.sinc"
@endif
;

#Second part of 32-bit instructions
define token instr2(16)
	wop0000=(0,0)
	wop0002=(0,2)
	wop0003=(0,3)
	wop0102=(1,2)
	wop0407=(4,7)
	wop0815=(8,15)
	wop1011=(10,11)
	wop1215=(12,15)
	wb07=(7,7)
	wRl=(8,11)

	wimm0307=(3,7)
	wcd10=(0,9)
	wscd12=(0,11) signed

	wimm16=(0,15)
	wsimm16=(0,15) signed
	wdisp16=(0,15) signed
@if IVC2_OPT == "1"
@include "ivc2_instr2.sinc"
@endif
;

@if IVC2_OPT == "1"
#Halfwords 1-3 of a 64-bit VLIW bundle
define token ivt1(16) ivt1_all=(0,15);
define token ivt2(16) ivt2_all=(0,15) ivt2_hi4=(12,15) ivt2_lo12=(0,11);
define token ivt3(16) ivt3_all=(0,15);
@endif

attach variables
	[ Rn Rm Rl RmA wRl ]
	[ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 tp gp sp ];

attach variables [ CRn CRn64 ]
	[ c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 ];

attach variables [ CRn32 ]
	[ c0l c1l c2l c3l c4l c5l c6l c7l c8l c9l c10l c11l c12l c13l c14l c15l ];

attach variables Rn07
	[ r0 r1 r2 r3 r4 r5 r6 r7 ];

#--------------------------#
#          Macros          #
#--------------------------#

macro SET_hi_lo(qword) {
	hi = qword(4);
	lo = qword:4;
}

#Coprocessor registers are modelled 64-bit wide; 32-bit transfers use the low word
#and leave the high word unchanged (implementation defined on 64-bit coprocessors).

#--------------------------#
#          Tables          #
#--------------------------#

JmpTarget24: target is imm0410; wimm16 [
	target = (inst_start & 0xF0000000) | (wimm16 << 8) | (imm0410 << 1);
] {
	export *:4 target;
}

BxxZTarget: target is simm0107 [ target = inst_start + (simm0107 << 1); ] {
	export *:4 target;
}

Bdisp12Target: target is simm0111 [ target = inst_start + (simm0111 << 1); ] {
	export *:4 target;
}

BSRTarget: target is imm0410; wdisp16 [
	target = inst_start + ((wdisp16 << 8) | (imm0410 << 1));
] {
	export *:4 target;
}

BcondTarget: target is op0000; wdisp16 [ target = inst_start + (wdisp16 << 1); ] {
	export *:4 target;
}

RmMem: "("^RmA^")" is RmA {
	export RmA;
}

@if COP_OPT == "1"
RmMemInc: "("^RmA^"+)" is RmA {
	export RmA;
}
@endif

RmDisp16: wdisp16^"("^RmA^")" is RmA; wdisp16 {
	local addr:4 = RmA + wdisp16;
	export addr;
}

SpDisp7: disp7^"("^sp^")" is imm0206 & sp [ disp7 = imm0206 << 2; ] {
	local addr:4 = sp + disp7;
	export *:4 addr;
}

TpDisp7Word: disp7^"("^tp^")" is imm0206 & tp [ disp7 = imm0206 << 2; ] {
	local addr:4 = tp + disp7;
	export *:4 addr;
}

TpDisp7Half: disp7^"("^tp^")" is imm0106 & tp [ disp7 = imm0106 << 1; ] {
	local addr:4 = tp + disp7;
	export *:2 addr;
}

TpDisp7Byte: imm0006^"("^tp^")" is imm0006 & tp {
	local addr:4 = tp + imm0006;
	export *:1 addr;
}

RmDisp16Word: wdisp16^"("^RmA^")" is RmA; wdisp16 {
	local addr:4 = RmA + wdisp16;
	export *:4 addr;
}

RmDisp16Half: wdisp16^"("^RmA^")" is RmA; wdisp16 {
	local addr:4 = RmA + wdisp16;
	export *:2 addr;
}

RmDisp16Byte: wdisp16^"("^RmA^")" is RmA; wdisp16 {
	local addr:4 = RmA + wdisp16;
	export *:1 addr;
}

#Control bus address (word address; the cbus space is byte-addressed)
CBusImm: wimm16 is wimm16 {
	local a:4 = wimm16 * 4;
	export *[cbus]:4 a;
}

CBusReg: "("^RmA^")" is RmA {
	local a:4 = (RmA & 0xffff) * 4;
	export *[cbus]:4 a;
}

#Control registers by number (STC/LDC): csrn = op0000:op0407
CSR: pc    is op0000=0 & op0407=0  & pc    { export pc; }
CSR: lp    is op0000=0 & op0407=1  & lp    { export lp; }
CSR: sar   is op0000=0 & op0407=2  & sar   { export sar; }
CSR: csr3  is op0000=0 & op0407=3  & csr3  { export csr3; }
CSR: rpb   is op0000=0 & op0407=4  & rpb   { export rpb; }
CSR: rpe   is op0000=0 & op0407=5  & rpe   { export rpe; }
CSR: rpc   is op0000=0 & op0407=6  & rpc   { export rpc; }
CSR: hi    is op0000=0 & op0407=7  & hi    { export hi; }
CSR: lo    is op0000=0 & op0407=8  & lo    { export lo; }
CSR: csr9  is op0000=0 & op0407=9  & csr9  { export csr9; }
CSR: csr10 is op0000=0 & op0407=10 & csr10 { export csr10; }
CSR: csr11 is op0000=0 & op0407=11 & csr11 { export csr11; }
CSR: mb0   is op0000=0 & op0407=12 & mb0   { export mb0; }
CSR: me0   is op0000=0 & op0407=13 & me0   { export me0; }
CSR: mb1   is op0000=0 & op0407=14 & mb1   { export mb1; }
CSR: me1   is op0000=0 & op0407=15 & me1   { export me1; }
CSR: psw   is op0000=1 & op0407=0  & psw   { export psw; }
CSR: id    is op0000=1 & op0407=1  & id    { export id; }
CSR: tmp   is op0000=1 & op0407=2  & tmp   { export tmp; }
CSR: epc   is op0000=1 & op0407=3  & epc   { export epc; }
CSR: exc   is op0000=1 & op0407=4  & exc   { export exc; }
CSR: cfg   is op0000=1 & op0407=5  & cfg   { export cfg; }
CSR: vid   is op0000=1 & op0407=6  & vid   { export vid; }
CSR: npc   is op0000=1 & op0407=7  & npc   { export npc; }
CSR: dbg   is op0000=1 & op0407=8  & dbg   { export dbg; }
CSR: depc  is op0000=1 & op0407=9  & depc  { export depc; }
CSR: opt   is op0000=1 & op0407=10 & opt   { export opt; }
CSR: rcfg  is op0000=1 & op0407=11 & rcfg  { export rcfg; }
CSR: ccfg  is op0000=1 & op0407=12 & ccfg  { export ccfg; }
CSR: csr29 is op0000=1 & op0407=13 & csr29 { export csr29; }
CSR: csr30 is op0000=1 & op0407=14 & csr30 { export csr30; }
CSR: csr31 is op0000=1 & op0407=15 & csr31 { export csr31; }

#Writable bits of each control register (STC). PC, ID, VID, OPT, RCFG and CCFG are read-only;
#CFG's cache-enable bits exist only with a cache. DBG is handled by its own STC constructor.
CSRW: 0xffffffff is op0407 { export 0xffffffff:4; }
CSRW: 0 is op0000=0 & op0407=0 { export 0:4; }
CSRW: 0x3f is op0000=0 & op0407=2 { export 0x3f:4; }
CSRW: 0xfffffffe is op0000=0 & op0407=4 { export 0xfffffffe:4; }
CSRW: 0xffff is op0000=0 & (op0407=12 | op0407=13 | op0407=14 | op0407=15) { export 0xffff:4; }
CSRW: 0x3ff is op0000=1 & op0407=0 { export 0x3ff:4; }
CSRW: 0 is op0000=1 & (op0407=1 | op0407=6 | op0407=10 | op0407=11 | op0407=12) { export 0:4; }
CSRW: 0x30f0 is op0000=1 & op0407=4 { export 0x30f0:4; }
CSRW: 0xc0001b is op0000=1 & op0407=5 { export 0xc0001b:4; }

RepeatBlockStart: is REPEAT_START {
	export *[ram]:4 REPEAT_START;
}

@if COP_OPT == "1"
#Coprocessor auto-increment displacement (10 bits; bits 8-9 are stored XOR-ed with bit 7,
#so the 8-bit MeP-c4 encodings keep their meaning)
CDisp10: val is wcd10 & wb07 [ val = (wcd10 $xor (wb07 * 0x300)) - (((wcd10 $xor (wb07 * 0x300)) >> 9) * 0x400); ] {
	export *[const]:4 val;
}
@endif

@if COP_OPT == "1"
CopInc: CDisp10 is (wop1011=0b00 | wop1011=0b10 | wop1011=0b11) & CDisp10 { export CDisp10; }

CopMode: "A"  is wop1011=0b00 { export 0:1; }
CopMode: "M0" is wop1011=0b10 { export 2:1; }
CopMode: "M1" is wop1011=0b11 { export 3:1; }

macro cop_update(r, d, mode) {
    local mb:4 = mb0 * zext(mode == 2) + mb1 * zext(mode == 3);
    local me:4 = me0 * zext(mode == 2) + me1 * zext(mode == 3);
    local mask:4 = 0xffffffff >> lzcount(mb | me);
    local wrap:4 = zext(mode != 0) * zext((r & mask) == me);
    r = ((r & ~mask) | mb) * wrap + (r + d) * (1 - wrap);
}

#MeP-c5 coprocessor byte/halfword loads and stores with a 12-bit displacement
#1111_nnnn_mmmm_0110 oooo_dddd_dddd_dddd

@endif

#--------------------------#
# MeP Core Instruction Set #
#--------------------------#

define pcodeop SynchronizeWithMemory;
define pcodeop SynchronizeWithCoprocessor;
define pcodeop BreakException;
define pcodeop Sleep;
define pcodeop DebugBreak;
define pcodeop CacheOperation;
define pcodeop CachePrefetch;
define pcodeop SoftwareInterrupt;
define pcodeop ReservedInstruction;
define pcodeop DivideByZero;

with :OM=0 {
#Generic instruction patterns (for REPEAT/EREPEAT) must come before any instruction

	#Penultimate instruction of REPEAT/EREPEAT block
	#This instruction is the one REPEAT/EREPEAT opcode points to (RPE). After it executes,
	#a REPEAT block decides whether to branch back: if RPC is not zero, RPC is decremented
	#and the block restarts after the next (last) instruction.
	:^instruction is REPEAT_REMAINING=2 & ELR=0 & instruction [
		#Markup next instruction for proper handling
		REPEAT_REMAINING = 1;
		globalset(inst_next, REPEAT_REMAINING);
		globalset(inst_next, REPEAT_START);
		globalset(inst_next, ELR);

		#Remove attribute for correct decoding during build
		REPEAT_REMAINING = 0;
	] {
		build instruction;
		rpt = (rpc != 0);
		rpc = rpc - zext(rpt);
	}

	:^instruction is REPEAT_REMAINING=2 & ELR=1 & instruction [
		REPEAT_REMAINING = 1;
		globalset(inst_next, REPEAT_REMAINING);
		globalset(inst_next, REPEAT_START);
		globalset(inst_next, ELR);
		REPEAT_REMAINING = 0;
	] {
		build instruction;
	}

	#Ultimate instruction of REPEAT block.
	:^instruction is REPEAT_REMAINING=1 & ELR=0 & instruction & RepeatBlockStart [
		REPEAT_REMAINING = 0;
	] {
		build instruction;
		if (rpt != 0) goto RepeatBlockStart;
	}

	#Ultimate instruction of EREPEAT block. Branches to repeat block start.
	:^instruction is REPEAT_REMAINING=1 & ELR=1 & instruction & RepeatBlockStart [
		REPEAT_REMAINING = 0;
	] {
		build instruction;
		goto RepeatBlockStart;
	}

    #-----------------#
    # Major Opcode 0  #
    #-----------------#

    with :major=0 {
        :MOV Rn,Rm is sub=0 & Rn & Rm { #0000_nnnn_mmmm_0000
            Rn = Rm;
        }

        #
        #    MeP-c4 Instruction Set Manual:
        #
        #The instruction "mov $0, $0" works as a NOP (no operation).
        #
        :NOP is sub=0 & Rn=0 & Rm=0 {}

        :NEG Rn,Rm is sub=1 & Rn & Rm { #0000_nnnn_mmmm_0001
            Rn = -Rm;
        }

        :SLT3 r0,Rn,Rm is sub=2 & r0 & Rn & Rm { #0000_nnnn_mmmm_0010
            r0 = zext(Rn s< Rm);
        }

        :SLTU3 r0,Rn,Rm is sub=3 & r0 & Rn & Rm { #0000_nnnn_mmmm_0011
            r0 = zext(Rn < Rm);
        }

        :SUB Rn,Rm is sub=4 & Rn & Rm { #0000_nnnn_mmmm_0100
            Rn = Rn - Rm;
        }

        :SBVCK3 r0,Rn,Rm is sub=5 & Rn & Rm & r0 { #0000_nnnn_mmmm_0101
            r0 = zext(sborrow(Rn, Rm));
        }

        :ADVCK3 r0,Rn,Rm is sub=7 & Rn & Rm & r0 { #0000_nnnn_mmmm_0111
            r0 = zext(scarry(Rn, Rm));
        }

        :SB Rn,RmMem is sub=8 & Rn & RmMem { #0000_nnnn_mmmm_1000
            *:1 RmMem = Rn:1;
        }

        :SH Rn,RmMem is sub=9 & Rn & RmMem { #0000_nnnn_mmmm_1001
            *:2 RmMem = Rn:2;
        }

        :SW Rn,RmMem is sub=10 & Rn & RmMem { #0000_nnnn_mmmm_1010
            *:4 RmMem = Rn;
        }

        :LBU Rn,RmMem is sub=11 & Rn & RmMem { #0000_nnnn_mmmm_1011
            Rn = zext(*:1 RmMem);
        }

        :LB Rn,RmMem is sub=12 & Rn & RmMem { #0000_nnnn_mmmm_1100
            Rn = sext(*:1 RmMem);
        }

        :LH Rn,RmMem is sub=13 & Rn & RmMem { #0000_nnnn_mmmm_1101
            Rn = sext(*:2 RmMem);
        }

        :LW Rn,RmMem is sub=14 & Rn & RmMem { #0000_nnnn_mmmm_1110
            Rn = *:4 RmMem;
        }

        :LHU Rn,RmMem is sub=15 & Rn & RmMem { #0000_nnnn_mmmm_1111
            Rn = zext(*:2 RmMem);
        }
    }

    #----------------#
    # Major Opcode 1 #
    #----------------#

    with :major=1 {
        :OR Rn,Rm is sub=0 & Rn & Rm { #0001_nnnn_mmmm_0000
            Rn = (Rn | Rm);
        }

        :AND Rn,Rm is sub=1 & Rn & Rm { #0001_nnnn_mmmm_0001
            Rn = (Rn & Rm);
        }

        :XOR Rn,Rm is sub=2 & Rn & Rm { #0001_nnnn_mmmm_0010
            Rn = (Rn ^ Rm);
        }

        :NOR Rn,Rm is sub=3 & Rn & Rm { #0001_nnnn_mmmm_0011
            Rn = ~(Rn | Rm);
        }

@if MUL_OPT == "1"
        :MUL Rn,Rm is sub=4 & Rn & Rm { #0001_nnnn_mmmm_0100
            local prod:8 = sext(Rn) * sext(Rm);
            SET_hi_lo(prod);
        }

        :MULU Rn,Rm is sub=5 & Rn & Rm { #0001_nnnn_mmmm_0101
            local prod:8 = zext(Rn) * zext(Rm);
            SET_hi_lo(prod);
        }

        :MULR Rn,Rm is sub=6 & Rn & Rm { #0001_nnnn_mmmm_0110
            local prod:8 = sext(Rn) * sext(Rm);
            SET_hi_lo(prod);
            Rn = prod:4;
        }

        :MULRU Rn,Rm is sub=7 & Rn & Rm { #0001_nnnn_mmmm_0111
            local prod:8 = zext(Rn) * zext(Rm);
            SET_hi_lo(prod);
            Rn = prod:4;
        }
@endif

@if DIV_OPT == "1"
        #Division by zero raises an exception (HI/LO unchanged);
        #0x80000000 / -1 gives LO = 0x80000000, HI = 0.
        :DIV Rn,Rm is sub=8 & Rn & Rm { #0001_nnnn_mmmm_1000
            if (Rm != 0) goto <divide>;
            DivideByZero();
            goto inst_next;
        <divide>
            if (Rn == 0x80000000 && Rm == 0xffffffff) goto <special>;
            lo = Rn s/ Rm;
            hi = Rn s% Rm;
            goto inst_next;
        <special>
            lo = 0x80000000;
            hi = 0;
        }

        :DIVU Rn,Rm is sub=9 & Rn & Rm { #0001_nnnn_mmmm_1001
            if (Rm != 0) goto <divide>;
            DivideByZero();
            goto inst_next;
        <divide>
            lo = Rn / Rm;
            hi = Rn % Rm;
        }
@endif

        #0001_00dd_mmmm_1100
        :SSARB imm0809^"("^Rm^")" is sub=12 & op1011=0 & imm0809 & Rm {
            local b:4 = ((imm0809 + Rm) & 3) * 8;
@if ENDIAN == "big"
            sar = b;
@else
            sar = 32 - b;
@endif
        }

        with :sub=13 {
            :EXTB Rn is Rm=0b0000 & Rn { #0001_nnnn_0000_1101
                Rn = sext(Rn:1);
            }

            :EXTH Rn is Rm=0b0010 & Rn { #0001_nnnn_0010_1101
                Rn = sext(Rn:2);
            }

            :EXTUB Rn is Rm=0b1000 & Rn { #0001_nnnn_1000_1101
                Rn = zext(Rn:1);
            }

            :EXTUH Rn is Rm=0b1010 & Rn { #0001_nnnn_1010_1101
                Rn = zext(Rn:2);
            }
        }

        #0001_0000_mmmm_1110
        #Bit 0 of the target selects the VLIW operation mode, which only a VLIW
        #(coprocessor) core has.
        :JMP Rm is sub=14 & Rn=0 & Rm {
            goto [Rm & 0xfffffffe];
        }

        #GCC returns with "jmp $11" after reloading the saved LP into $11
        #(REGSAVE_CONTROL_TEMP) when a function saved LP; it uses no other "jmp $11".
        :JMP Rm is sub=14 & Rn=0 & Rm & Rm=11 & SIBJ=0 {
            return [Rm & 0xfffffffe];
        }

        #0001_0000_mmmm_1111
        :JSR Rm is sub=15 & Rn=0 & Rm {
            lp = inst_next;
            call [Rm & 0xfffffffe];
        }

@if COP_OPT == "1"
        #0001_1000_mmmm_1111: call a VLIW-mode subroutine (LP bit 0 returns to core mode)
        :JSRV Rm is sub=15 & Rn=0b1000 & Rm {
            lp = inst_next | 1;
            call [Rm & 0xfffffffe];
        }
@endif
    }

    #----------------#
    # Major Opcode 2 #
    #----------------#

    with :major=2 {
@if BIT_OPT == "1"
        with :op1111=0 {
            :BSETM RmMem,imm0810 is sub=0 & RmMem & imm0810 { #0010_0iii_mmmm_0000
                local bit:1 = (1 << imm0810);
                *:1 RmMem = (*:1 RmMem | bit);
            }

            :BCLRM RmMem,imm0810 is sub=1 & RmMem & imm0810 { #0010_0iii_mmmm_0001
                local mask:1 = ~(1 << imm0810);
                *:1 RmMem = (*:1 RmMem & mask);
            }

            :BNOTM RmMem,imm0810 is sub=2 & RmMem & imm0810 { #0010_0iii_mmmm_0010
                local bit:1 = (1 << imm0810);
                *:1 RmMem = (*:1 RmMem ^ bit);
            }

            #R0 receives the tested bit in place (0 or 1 << imm3)
            :BTSTM r0,RmMem,imm0810 is sub=3 & r0 & RmMem & imm0810 { #0010_0iii_mmmm_0011
                local bit:1 = (1 << imm0810);
                local mem:1 = *:1 RmMem;
                r0 = zext(bit & mem);
            }
        }

        :TAS Rn,RmMem is sub=4 & Rn & RmMem { #0010_nnnn_mmmm_0100
            local old:1 = *:1 RmMem;
            *:1 RmMem = 1;
            Rn = zext(old);
        }
@endif

        :SL1AD3 r0,Rn,Rm is sub=6 & r0 & Rn & Rm { #0010_nnnn_mmmm_0110
            r0 = (Rn << 1) + Rm;
        }

        :SL2AD3 r0,Rn,Rm is sub=7 & r0 & Rn & Rm { #0010_nnnn_mmmm_0111
            r0 = (Rn << 2) + Rm;
        }

        :SRL Rn,Rm is sub=12 & Rn & Rm { #0010_nnnn_mmmm_1100
            Rn = (Rn >> (Rm & 0x1F));
        }

        :SRA Rn,Rm is sub=13 & Rn & Rm { #0010_nnnn_mmmm_1101
            Rn = (Rn s>> (Rm & 0x1F));
        }

        :SLL Rn,Rm is sub=14 & Rn & Rm { #0010_nnnn_mmmm_1110
            Rn = (Rn << (Rm & 0x1F));
        }

        :FSFT Rn,Rm is sub=15 & Rn & Rm { #0010_nnnn_mmmm_1111
            local res:8 = (zext(Rn) << 32) | zext(Rm);
            res = (res << (sar & 0x3f));
            Rn = res(4);
        }
    }

    #----------------#
    # Major Opcode 3 #
    #----------------#

@if COP_OPT == "1"
    with :major=3 {
        :SWCPI CRn,RmMemInc is sub=0 & CRn & RmMemInc & CRn32 & RmA { #0011_nnnn_mmmm_0000
            *:4 RmA = CRn32;
            RmA = RmA + 4;
        }

        #On a coprocessor with registers wider than 32 bits the upper half is left unchanged.
        :LWCPI CRn,RmMemInc is sub=1 & CRn & RmMemInc & CRn32 & RmA { #0011_nnnn_mmmm_0001
            CRn32 = *:4 RmA;
            RmA = RmA + 4;
        }

        :SMCPI CRn,RmMemInc is sub=2 & CRn & RmMemInc & RmA { #0011_nnnn_mmmm_0010
            *:8 RmA = CRn;
            RmA = RmA + 8;
        }

        :LMCPI CRn,RmMemInc is sub=3 & CRn & RmMemInc & RmA { #0011_nnnn_mmmm_0011
            CRn = *:8 RmA;
            RmA = RmA + 8;
        }

        :SWCP CRn,RmMem is sub=8 & CRn & RmMem & CRn32 { #0011_nnnn_mmmm_1000
            *:4 RmMem = CRn32;
        }

        :LWCP CRn,RmMem is sub=9 & CRn & RmMem & CRn32 { #0011_nnnn_mmmm_1001
            CRn32 = *:4 RmMem;
        }

        :SMCP CRn,RmMem is sub=10 & CRn & RmMem { #0011_nnnn_mmmm_1010
            *:8 RmMem = CRn;
        }

        :LMCP CRn,RmMem is sub=11 & CRn & RmMem { #0011_nnnn_mmmm_1011
            CRn = *:8 RmMem;
        }
    }
@endif

    #----------------#
    # Major Opcode 4 #
    #----------------#

    with :major=4 {
        with :op0707=0 {
            #0100_nnnn_0iii_ii00 (imm7=iii_ii||00)
            :ADD3 Rn,sp,imm7 is sub2=0b00 & Rn & imm0206 & sp [ imm7 = imm0206 << 2; ] {
                Rn = sp + imm7;
            }

            #0100_nnnn_0ddd_dd10 (disp7=ddd_dd||00)
            :SW Rn,SpDisp7 is sub2=0b10 & Rn & SpDisp7 {
                SpDisp7 = Rn;
            }

            #0100_nnnn_0ddd_dd11
            :LW Rn,SpDisp7 is sub2=0b11 & Rn & SpDisp7 {
                Rn = SpDisp7;
            }
        }

        with :op0707=1 {
            with :op1111=0 {
                #0100_0nnn_1ddd_dd10
                :SW Rn07,TpDisp7Word is sub2=0b10 & Rn07 & TpDisp7Word {
                    TpDisp7Word = Rn07;
                }

                #0100_0nnn_1ddd_dd11
                :LW Rn07,TpDisp7Word is sub2=0b11 & Rn07 & TpDisp7Word {
                    Rn07 = TpDisp7Word;
                }
            }

            #0100_1nnn_1ddd_dddd (disp7=ddd_dddd)
            :LBU Rn07,TpDisp7Byte is op1111=1 & Rn07 & TpDisp7Byte {
                Rn07 = zext(TpDisp7Byte);
            }
        }
    }

    #----------------#
    # Major Opcode 5 #
    #----------------#

    :MOV Rn,simm0007 is major=5 & Rn & simm0007 {
        Rn = simm0007;
    }

    #----------------#
    # Major Opcode 6 #
    #----------------#

    with :major=6 {
        #0110_nnnn_iiii_ii00
        :ADD Rn,simm0207 is sub2=0b00 & Rn & simm0207 {
            Rn = Rn + simm0207;
        }

        #0110_nnnn_iiii_i001 (imm5=iiii_i)
        :SLT3 r0,Rn,imm0307 is sub3=0b001 & r0 & Rn & imm0307 {
            r0 = zext(Rn s< imm0307);
        }

        #0110_nnnn_iiii_i010
        :SRL Rn,imm0307 is sub3=0b010 & Rn & imm0307 {
            Rn = (Rn >> imm0307);
        }

        #0110_nnnn_iiii_i011
        :SRA Rn,imm0307 is sub3=0b011 & Rn & imm0307 {
            Rn = (Rn s>> imm0307);
        }

        #0110_nnnn_iiii_i101
        :SLTU3 r0,Rn,imm0307 is sub3=0b101 & r0 & Rn & imm0307 {
            r0 = zext(Rn < imm0307);
        }

        #0110_nnnn_iiii_i110
        :SLL Rn,imm0307 is sub3=0b110 & Rn & imm0307 {
            Rn = (Rn << imm0307);
        }

        #0110_nnnn_iiii_i111
        :SLL3 r0,Rn,imm0307 is sub3=0b111 & r0 & Rn & imm0307 {
            r0 = (Rn << imm0307);
        }
    }

    #----------------#
    # Major Opcode 7 #
    #----------------#

    with :major=7 {
        with :sub=0b0000 & Rn=0 {
            #PSW.IEC is bit 0
            :DI is Rm=0 { #0111_0000_0000_0000
                psw = psw & 0xfffffffe;
            }

            :EI is Rm=1 { #0111_0000_0001_0000
                psw = psw | 1;
            }
        }

        with :sub=0b0001 & Rn=0 {
            :SYNCM is Rm=1 { #0111_0000_0001_0001
                SynchronizeWithMemory();
            }

@if COP_OPT == "1"
            :SYNCCP is Rm=2 { #0111_0000_0010_0001
                SynchronizeWithCoprocessor();
            }
@endif
        }

        with :sub=0b0010 & Rn=0 {
            :RET is Rm=0b0000 { #0111_0000_0000_0010
                return [lp & 0xfffffffe];
            }

            #Returns to NPC after an NMI (PSW.NMI, bit 9), otherwise to EPC, restoring
            #PSW.UMC (bit 2) from UMP (bit 3) and PSW.IEC (bit 0) from IEP (bit 1).
            :RETI is Rm=0b0001 { #0111_0000_0001_0010
                local target:4 = epc;
                if ((psw & 0x200) != 0) goto <nmi>;
                psw = (psw & 0xfffffffa) | ((psw >> 1) & 0x4) | ((psw >> 1) & 0x1);
                return [target & 0xfffffffe];
            <nmi>
                target = npc;
                psw = psw & 0xfffffdff;
                return [target & 0xfffffffe];
            }

            #Sets PSW.HALT (bit 11); execution resumes after an interrupt
            :HALT is Rm=0b0010 { #0111_0000_0010_0010
                psw = psw | 0x800;
            }

            :BREAK is Rm=0b0011 { #0111_0000_0011_0010
                BreakException();
            }

            :SLEEP is Rm=0b0110 { #0111_0000_0110_0010
                Sleep();
            }
        }

@if DBG_OPT == "1"
        with :sub=0b0011 & Rn=0 {
            #Clears DBG.DM (bit 15) and returns to DEPC
            :DRET is Rm=0b0001 { #0111_0000_0001_0011
                dbg = dbg & 0xffff7fff;
                return [depc];
            }

            #Sets DBG.DPB (bit 0)
            :DBREAK is Rm=0b0011 { #0111_0000_0011_0011
                dbg = dbg | 1;
                DebugBreak();
            }
        }
@endif

        #0111_iiii_mmmm_0100
        :CACHE imm0811,RmMem is sub=0b0100 & imm0811 & RmMem {
            CacheOperation(imm0811:1, RmMem);
        }

        #0111_iiii_mmmm_0101 (MeP-c5)
        :PREF imm0811,RmMem is sub=0b0101 & imm0811 & RmMem {
            CachePrefetch(imm0811:1, RmMem);
        }

        #0111_1nnn_000n_0000: system call of the GNU/SID MeP simulators (libgloss's sim runtime);
        #a reserved instruction on hardware. Number = bits 10-8 and 4; result in $0, errno in $1.
        define pcodeop SimulatorSyscall;
        define pcodeop SimulatorErrno;
        :SIM_SYSCALL num is sub=0 & op1111=1 & op0507=0 & op0810 & imm0405 [ num = (op0810 << 1) | (imm0405 & 1); ] {
            r0 = SimulatorSyscall(num:1, r1, r2, r3, r4);
            r1 = SimulatorErrno();
        }

        #0111_0000_00ii_0110: sets EXC.SIP<n> (bit 4+n), the software interrupt request
        :SWI imm0405 is sub=0b0110 & op0611=0 & imm0405 {
            exc = exc | (1 << (4 + imm0405));
            SoftwareInterrupt(imm0405:1);
        }

        #0111_nnnn_cccc_100C: STC Rn,CSR (csrn = C||cccc); only the writable bits change
        :STC Rn,CSR is op0103=0b100 & Rn & CSR & CSRW {
            CSR = (CSR & ~CSRW) | (Rn & CSRW);
        }

        #Writes to PC are ignored
        :STC Rn,CSR is op0103=0b100 & Rn & CSR & op0000=0 & op0407=0 { }

        #GCC's sibling call that switches the operation mode ends with
        #"xor3 $12,$12,1; add3 $11,$11,%lo(f+1); stc $12,$lp; jmp $11": the jmp is not a return
        :STC Rn,CSR is op0103=0b100 & Rn & Rn=12 & CSR & CSRW & op0000=0 & op0407=1 [ SIBJ = 1; globalset(inst_next, SIBJ); ] {
            CSR = (CSR & ~CSRW) | (Rn & CSRW);
        }

        #DBG: bit 10 (BSF) can only be cleared; bits 7-8 are writable
        :STC Rn,CSR is op0103=0b100 & Rn & CSR & op0000=1 & op0407=8 {
            local m:4 = 0x180 | (0x400 * zext((Rn & 0x400) == 0));
            CSR = (CSR & ~m) | (Rn & m);
        }

        #0111_nnnn_cccc_101C: LDC Rn,CSR
        :LDC Rn,CSR is op0103=0b101 & Rn & CSR {
            Rn = CSR;
        }

        :LDC Rn,CSR is op0103=0b101 & Rn & CSR & op0000=0 & op0407=0 {
            Rn = inst_start;
        }

        #0111_nnnn_mmmm_1100: STCB Rn,(Rm) (MeP-c5, control bus address = Rm & 0xffff)
        :STCB Rn,CBusReg is sub=0b1100 & Rn & CBusReg {
            CBusReg = Rn;
        }

        #0111_nnnn_mmmm_1101: LDCB Rn,(Rm) (MeP-c5)
        :LDCB Rn,CBusReg is sub=0b1101 & Rn & CBusReg {
            Rn = CBusReg;
        }
    }

    #----------------#
    # Major Opcode 8 #
    #----------------#

    with :major=8 {
        #1000_0nnn_0ddd_dddd (disp7 = ddd_dddd)
        :SB Rn07,TpDisp7Byte is op0707=0 & op1111=0 & Rn07 & TpDisp7Byte {
            TpDisp7Byte = Rn07:1;
        }

        #1000_0nnn_1ddd_ddd0 (disp7 = ddd_ddd||0)
        :SH Rn07,TpDisp7Half is op0000=0 & op0707=1 & op1111=0 & Rn07 & TpDisp7Half {
            TpDisp7Half = Rn07:2;
        }

        #1000_1nnn_0ddd_dddd
        :LB Rn07,TpDisp7Byte is op0707=0 & op1111=1 & Rn07 & TpDisp7Byte {
            Rn07 = sext(TpDisp7Byte);
        }

        #1000_1nnn_1ddd_ddd0
        :LH Rn07,TpDisp7Half is op0000=0 & op0707=1 & op1111=1 & Rn07 & TpDisp7Half {
            Rn07 = sext(TpDisp7Half);
        }

        #1000_1nnn_1ddd_ddd1
        :LHU Rn07,TpDisp7Half is op0000=1 & op0707=1 & op1111=1 & Rn07 & TpDisp7Half {
            Rn07 = zext(TpDisp7Half);
        }
    }

    #----------------#
    # Major Opcode 9 #
    #----------------#

    :ADD3 Rl,Rn,Rm is major=9 & Rl & Rn & Rm {
        Rl = Rn + Rm;
    }

    #-----------------#
    # Major Opcode 10 #
    #-----------------#

    with :major=10 {
        #1010_nnnn_dddd_ddd0 (disp8=dddd_ddd||0)
        :BEQZ Rn,BxxZTarget is op0000=0 & Rn & BxxZTarget {
            if (Rn == 0) goto BxxZTarget;
        }

        #1010_nnnn_dddd_ddd1
        :BNEZ Rn,BxxZTarget is op0000=1 & Rn & BxxZTarget {
            if (Rn != 0) goto BxxZTarget;
        }
    }

    #-----------------#
    # Major Opcode 11 #
    #-----------------#

    with :major=11 {
        #1011_dddd_dddd_ddd0 (disp12=dddd_dddd_ddd||0)
        :BRA Bdisp12Target is op0000=0 & Bdisp12Target {
            goto Bdisp12Target;
        }

        #1011_dddd_dddd_ddd1
        :BSR Bdisp12Target is op0000=1 & Bdisp12Target {
            lp = inst_next;
            call Bdisp12Target;
        }
    }

    #--------------------------#
    # Major Opcode 12 (32 bit) #
    #--------------------------#

    #1100_nnnn_mmmm_0000 iiii_iiii_iiii_iiii (imm16=iiii_iiii_iiii_iiii)
    :ADD3 Rn,Rm,wsimm16 is (major=12 & sub=0 & Rn & Rm); wsimm16 {
        Rn = Rm + wsimm16;
    }

    #1100_nnnn_0000_0001 iiii_iiii_iiii_iiii
    :MOV Rn,wsimm16 is (major=12 & sub=1 & Rm=0 & Rn); wsimm16 {
        Rn = wsimm16;
    }

    #1100_nnnn_0001_0001 iiii_iiii_iiii_iiii
    :MOVU Rn,wimm16 is (major=12 & sub=1 & Rm=1 & Rn); wimm16 {
        Rn = wimm16;
    }

    #1100_nnnn_0010_0001 iiii_iiii_iiii_iiii
    :MOVH Rn,wimm16 is (major=12 & sub=1 & Rm=2 & Rn); wimm16 {
        Rn = wimm16 << 16;
    }

    #1100_nnnn_mmmm_0010 iiii_iiii_iiii_iiii
    :SLT3 Rn,Rm,wsimm16 is (major=12 & sub=2 & Rn & Rm); wsimm16 {
        Rn = zext(Rm s< wsimm16);
    }

    #1100_nnnn_mmmm_0011 iiii_iiii_iiii_iiii
    :SLTU3 Rn,Rm,wimm16 is (major=12 & sub=3 & Rn & Rm); wimm16 {
        Rn = zext(Rm < wimm16);
    }

    #1100_nnnn_mmmm_0100 iiii_iiii_iiii_iiii
    :OR3 Rn,Rm,wimm16 is (major=12 & sub=4 & Rn & Rm); wimm16 {
        Rn = Rm | wimm16;
    }

    #1100_nnnn_mmmm_0101 iiii_iiii_iiii_iiii
    :AND3 Rn,Rm,wimm16 is (major=12 & sub=5 & Rn & Rm); wimm16 {
        Rn = Rm & wimm16;
    }

    #1100_nnnn_mmmm_0110 iiii_iiii_iiii_iiii
    :XOR3 Rn,Rm,wimm16 is (major=12 & sub=6 & Rn & Rm); wimm16 {
        Rn = Rm ^ wimm16;
    }

    #1100_nnnn_mmmm_1000 dddd_dddd_dddd_dddd (disp16=dddd_dddd_dddd_dddd)
    :SB Rn,RmDisp16Byte is (major=12 & sub=8 & Rn) ... & RmDisp16Byte {
        RmDisp16Byte = Rn:1;
    }

    #1100_nnnn_mmmm_1001 dddd_dddd_dddd_dddd
    :SH Rn,RmDisp16Half is (major=12 & sub=9 & Rn) ... & RmDisp16Half {
        RmDisp16Half = Rn:2;
    }

    #1100_nnnn_mmmm_1010 dddd_dddd_dddd_dddd
    :SW Rn,RmDisp16Word is (major=12 & sub=10 & Rn) ... & RmDisp16Word {
        RmDisp16Word = Rn;
    }

    #1100_nnnn_mmmm_1011 dddd_dddd_dddd_dddd
    :LBU Rn,RmDisp16Byte is (major=12 & sub=11 & Rn) ... & RmDisp16Byte {
        Rn = zext(RmDisp16Byte);
    }

    #1100_nnnn_mmmm_1100 dddd_dddd_dddd_dddd
    :LB Rn,RmDisp16Byte is (major=12 & sub=12 & Rn) ... & RmDisp16Byte {
        Rn = sext(RmDisp16Byte);
    }

    #1100_nnnn_mmmm_1101 dddd_dddd_dddd_dddd
    :LH Rn,RmDisp16Half is (major=12 & sub=13 & Rn) ... & RmDisp16Half {
        Rn = sext(RmDisp16Half);
    }

    #1100_nnnn_mmmm_1110 dddd_dddd_dddd_dddd
    :LW Rn,RmDisp16Word is (major=12 & sub=14 & Rn) ... & RmDisp16Word {
        Rn = RmDisp16Word;
    }

    #1100_nnnn_mmmm_1111 dddd_dddd_dddd_dddd
    :LHU Rn,RmDisp16Half is (major=12 & sub=15 & Rn) ... & RmDisp16Half {
        Rn = zext(RmDisp16Half);
    }

    #--------------------------#
    # Major Opcode 13 (32-bit) #
    #--------------------------#

    #1101_0nnn_IIII_IIII iiii_iiii_iiii_iiii (imm24=iiii_iiii_iiii_iiii||IIII_IIII)
    :MOVU Rn07,imm24 is major=13 & op1111=0 & Rn07 & imm0007; wimm16 [ imm24 = imm0007 | (wimm16 << 8); ] {
        Rn07 = imm24;
    }

@if COP_OPT == "1"
    #Branch on the coprocessor condition (CCR1)
    #1101_1000_cccc_0100 dddd_dddd_dddd_dddd (disp17=dddd_dddd_dddd_dddd||0)
    :BCPEQ cccc,BcondTarget is (major=13 & op0811=0b1000 & sub=4 & cccc) ... & BcondTarget {
        if ((cccc ^ $(CP_FLAG)) == 0) goto BcondTarget;
    }

    #1101_1000_cccc_0101 dddd_dddd_dddd_dddd
    :BCPNE cccc,BcondTarget is (major=13 & op0811=0b1000 & sub=5 & cccc) ... & BcondTarget {
        if ((cccc ^ $(CP_FLAG)) != 0) goto BcondTarget;
    }

    #1101_1000_cccc_0110 dddd_dddd_dddd_dddd
    :BCPAT cccc,BcondTarget is (major=13 & op0811=0b1000 & sub=6 & cccc) ... & BcondTarget {
        if ((cccc & $(CP_FLAG)) != 0) goto BcondTarget;
    }

    #1101_1000_cccc_0111 dddd_dddd_dddd_dddd
    :BCPAF cccc,BcondTarget is (major=13 & op0811=0b1000 & sub=7 & cccc) ... & BcondTarget {
        if ((cccc & $(CP_FLAG)) == 0) goto BcondTarget;
    }
@endif

    #1101_1TTT_TTTT_1000 tttt_tttt_tttt_tttt (target24=tttt_tttt_tttt_tttt||TTT_TTTT||0)
    :JMP JmpTarget24 is (major=13 & op1111=1 & sub=8) ... & JmpTarget24 {
        goto JmpTarget24;
    }

    #1101_1DDD_DDDD_1001 dddd_dddd_dddd_dddd (disp24=dddd_dddd_dddd_dddd||DDD_DDDD||0)
    :BSR BSRTarget is (major=13 & op1111=1 & sub=9) ... & BSRTarget {
        lp = inst_next;
        call BSRTarget;
    }

@if COP_OPT == "1"
    #1101_1DDD_DDDD_1011 dddd_dddd_dddd_dddd: call a VLIW-mode subroutine
@if IVC2_OPT == "1"
    #The target runs in VLIW mode when called from core mode, and in core mode when called
    #from a VLIW bundle
    :BSRV BSRTarget is (major=13 & op1111=1 & sub=11) ... & BSRTarget [
        OM = INVLIW $xor 1;
        globalset(BSRTarget, OM);
    ] {
        lp = inst_next | 1;
        call BSRTarget;
    }
@else
    :BSRV BSRTarget is (major=13 & op1111=1 & sub=11) ... & BSRTarget {
        lp = inst_next | 1;
        call BSRTarget;
    }
@endif
@endif

    #--------------------------#
    # Major Opcode 14 (32-bit) #
    #--------------------------#

    #1110_nnnn_iiii_0000 dddd_dddd_dddd_dddd
    :BEQI Rn,imm0407,BcondTarget is (major=14 & sub=0b0000 & Rn & imm0407) ... & BcondTarget {
        if (Rn == imm0407) goto BcondTarget;
    }

    #1110_nnnn_mmmm_0001 dddd_dddd_dddd_dddd
    :BEQ Rn,Rm,BcondTarget is (major=14 & sub=0b0001 & Rn & Rm) ... & BcondTarget {
        if (Rn == Rm) goto BcondTarget;
    }

    #1110_nnnn_iiii_0100 dddd_dddd_dddd_dddd
    :BNEI Rn,imm0407,BcondTarget is (major=14 & sub=0b0100 & Rn & imm0407) ... & BcondTarget {
        if (Rn != imm0407) goto BcondTarget;
    }

    #1110_nnnn_mmmm_0101 dddd_dddd_dddd_dddd
    :BNE Rn,Rm,BcondTarget is (major=14 & sub=0b0101 & Rn & Rm) ... & BcondTarget {
        if (Rn != Rm) goto BcondTarget;
    }

    #1110_nnnn_iiii_1000 dddd_dddd_dddd_dddd
    :BGEI Rn,imm0407,BcondTarget is (major=14 & sub=0b1000 & Rn & imm0407) ... & BcondTarget {
        if (Rn s>= imm0407) goto BcondTarget;
    }

    #1110_nnnn_iiii_1100 dddd_dddd_dddd_dddd
    :BLTI Rn,imm0407,BcondTarget is (major=14 & sub=0b1100 & Rn & imm0407) ... & BcondTarget {
        if (Rn s< imm0407) goto BcondTarget;
    }

    #1110_nnnn_0000_1001 dddd_dddd_dddd_dddd
    #RPB = address after REPEAT (after its bundle in VLIW mode), RPE = target (the
    #second-to-last instruction of the block),
    #RPC = Rn: the block runs Rn+1 times.
    :REPEAT Rn,end is major=14 & Rm=0 & sub=9 & Rn; wsimm16 [
        end = inst_start + (wsimm16 << 1);

        #Save required info to the target instruction
        REPEAT_START = inst_start + 4 + (INVLIW * 4);
        REPEAT_REMAINING = 2;
        ELR = 0;
        globalset(end, REPEAT_START);
        globalset(end, REPEAT_REMAINING);
        globalset(end, ELR);
    ] {
        rpb = inst_next;
        rpe = end;
        rpc = Rn;
    }

    #1110_0000_0001_1001 dddd_dddd_dddd_dddd
    :EREPEAT end is major=14 & Rn=0 & Rm=1 & sub=9 ; wsimm16 [
        end = inst_start + (wsimm16 << 1);

        #Save required info to the target instruction
        ELR = 1;
        REPEAT_START = inst_start + 4 + (INVLIW * 4);
        REPEAT_REMAINING = 2;
        globalset(end, REPEAT_START);
        globalset(end, REPEAT_REMAINING);
        globalset(end, ELR);
    ] {
        rpb = inst_next;
        rpe = end | 1; #Set ELR
        rpc = 1;
    }

    #1110_nnnn_DDDD_DD10 dddd_dddd_dddd_dddd (abs24=dddd_dddd_dddd_dddd||DDDD_DD||00)
    :SW Rn,(abs24) is major=14 & sub2=0b10 & Rn & imm0207; wimm16 [ abs24 = (wimm16 << 8) | (imm0207 << 2); ] {
        *:4 abs24:4 = Rn;
    }

    #1110_nnnn_DDDD_DD11 dddd_dddd_dddd_dddd
    :LW Rn,(abs24) is major=14 & sub2=0b11 & Rn & imm0207; wimm16 [ abs24 = (wimm16 << 8) | (imm0207 << 2); ] {
        Rn = *:4 abs24:4;
    }

    #--------------------------#
    # Major Opcode 15 (32-bit) #
    #--------------------------#

@if (DSP_OPT == "1") && (NO_DEFAULT_DSP_INSTR == "0")
    #There are three variants of the DSP instruction (DSP Rn,Rm,code16; DSP0 code24;
    #DSP1 Rn,code20) sharing one encoding; their operation is defined by the DSP unit
    #the core was built with. Shown in the binutils form, DSP Rn,Rm,code16.

    #1111_nnnn_mmmm_0000 cccc_cccc_cccc_cccc
    define pcodeop DSPOperation;
    :DSP Rn,Rm,wimm16 is major=15 & sub=0 & Rn & Rm; wimm16 {
        Rn = DSPOperation(Rn, Rm, wimm16:2);
    }
@endif

@if LDZ_OPT == "1"
        #1111_nnnn_mmmm_0001 0000_0000_0000_0000
        :LDZ Rn,Rm is major=15 & sub=1 & Rn & Rm; wimm16=0 {
            Rn = lzcount(Rm);
        }
@endif

@if AVE_OPT == "1"
        #1111_nnnn_mmmm_0001 0000_0000_0000_0010
        :AVE Rn,Rm is major=15 & sub=1 & Rn & Rm; wimm16=2 {
            Rn = (Rn + Rm + 1) s>> 1;
        }
@endif

@if ABS_OPT == "1"
        #1111_nnnn_mmmm_0001 0000_0000_0000_0011
        :ABS Rn,Rm is major=15 & sub=1 & Rn & Rm; wimm16=3 {
            local res:4 = Rn - Rm;
            local neg:4 = zext(res s< 0);
            Rn = (res ^ (0 - neg)) + neg;
        }
@endif

@if MIN_OPT == "1"
        #1111_nnnn_mmmm_0001 0000_0000_0000_0100
        :MIN Rn,Rm is major=15 & sub=1 & Rn & Rm; wimm16=4 {
            local c:4 = zext(Rn s> Rm);
            Rn = Rn * (1 - c) + Rm * c;
        }

        #1111_nnnn_mmmm_0001 0000_0000_0000_0101
        :MAX Rn,Rm is major=15 & sub=1 & Rn & Rm; wimm16=5 {
            local c:4 = zext(Rn s< Rm);
            Rn = Rn * (1 - c) + Rm * c;
        }

        #1111_nnnn_mmmm_0001 0000_0000_0000_0110
        :MINU Rn,Rm is major=15 & sub=1 & Rn & Rm; wimm16=6 {
            local c:4 = zext(Rn > Rm);
            Rn = Rn * (1 - c) + Rm * c;
        }

        #1111_nnnn_mmmm_0001 0000_0000_0000_0111
        :MAXU Rn,Rm is major=15 & sub=1 & Rn & Rm; wimm16=7 {
            local c:4 = zext(Rn < Rm);
            Rn = Rn * (1 - c) + Rm * c;
        }
@endif

@if SAT_OPT == "1"
        #On signed overflow the result saturates towards the sign of Rn.
        #1111_nnnn_mmmm_0001 0000_0000_0000_1000
        :SADD Rn,Rm is major=15 & sub=1 & Rn & Rm; wimm16=8 {
            local ov:1 = scarry(Rn, Rm);
            local sat:4 = 0x7fffffff + zext(Rn s< 0);
            Rn = (Rn + Rm) * zext(ov == 0) + sat * zext(ov);
        }

        #1111_nnnn_mmmm_0001 0000_0000_0000_1001
        :SADDU Rn,Rm is major=15 & sub=1 & Rn & Rm; wimm16=9 {
            local c:1 = carry(Rn, Rm);
            Rn = (Rn + Rm) | (0 - zext(c));
        }

        #1111_nnnn_mmmm_0001 0000_0000_0000_1010
        :SSUB Rn,Rm is major=15 & sub=1 & Rn & Rm; wimm16=10 {
            local ov:1 = sborrow(Rn, Rm);
            local sat:4 = 0x7fffffff + zext(Rn s< 0);
            Rn = (Rn - Rm) * zext(ov == 0) + sat * zext(ov);
        }

        #1111_nnnn_mmmm_0001 0000_0000_0000_1011
        :SSUBU Rn,Rm is major=15 & sub=1 & Rn & Rm; wimm16=11 {
            local b:4 = zext(Rn < Rm);
            Rn = (Rn - Rm) * (1 - b);
        }
@endif

@if CLP_OPT == "1"
        #1111_nnnn_0000_0001 0001_0000_iiii_i000 (imm5=iiii_i)
        #imm5 = 0 gives 0; otherwise clamps to [-2^(imm5-1), 2^(imm5-1)-1]
        :CLIP Rn,wimm0307 is major=15 & sub=1 & Rm=0 & Rn; wop0815=0x10 & wop0002=0 & wimm0307 {
            local n:4 = wimm0307;
            local upr:4 = (1 << (n - 1)) - 1;
            local lwr:4 = -(1 << (n - 1));
            local v:4 = Rn;
            if (n == 0) goto <zero>;
            if (v s> upr) goto <set_upr>;
            if (v s< lwr) goto <set_lwr>;
            goto inst_next;
        <set_lwr>
            Rn = lwr;
            goto inst_next;
        <set_upr>
            Rn = upr;
            goto inst_next;
        <zero>
            Rn = 0;
        }

        #1111_nnnn_0000_0001 0001_0000_iiii_i001
        #imm5 = 0 gives 0; otherwise clamps (signed) to [0, 2^imm5-1]
        :CLIPU Rn,wimm0307 is major=15 & sub=1 & Rm=0 & Rn; wop0815=0x10 & wop0002=1 & wimm0307 {
            local n:4 = wimm0307;
            local upr:4 = (1 << n) - 1;
            local v:4 = Rn;
            if (n == 0) goto <zero>;
            if (v s> upr) goto <set_upr>;
            if (v s< 0) goto <zero>;
            goto inst_next;
        <set_upr>
            Rn = upr;
            goto inst_next;
        <zero>
            Rn = 0;
        }
@endif

@if MUL_OPT == "1"
        #1111_nnnn_mmmm_0001 0011_0000_0000_0100
        :MADD Rn,Rm is major=15 & sub=1 & Rn & Rm; wimm16=0x3004 {
            local old:8 = (zext(hi) << 32) | zext(lo);
            local new:8 = old + sext(Rn) * sext(Rm);
            SET_hi_lo(new);
        }

        #1111_nnnn_mmmm_0001 0011_0000_0000_0101
        :MADDU Rn,Rm is major=15 & sub=1 & Rn & Rm; wimm16=0x3005 {
            local old:8 = (zext(hi) << 32) | zext(lo);
            local new:8 = old + zext(Rn) * zext(Rm);
            SET_hi_lo(new);
        }

        #1111_nnnn_mmmm_0001 0011_0000_0000_0110
        :MADDR Rn,Rm is major=15 & sub=1 & Rn & Rm; wimm16=0x3006 {
            local old:8 = (zext(hi) << 32) | zext(lo);
            local new:8 = old + sext(Rn) * sext(Rm);
            SET_hi_lo(new);
            Rn = new:4;
        }

        #1111_nnnn_mmmm_0001 0011_0000_0000_0111
        :MADDRU Rn,Rm is major=15 & sub=1 & Rn & Rm; wimm16=0x3007 {
            local old:8 = (zext(hi) << 32) | zext(lo);
            local new:8 = old + zext(Rn) * zext(Rm);
            SET_hi_lo(new);
            Rn = new:4;
        }
@endif

@if BIT_OPT == "1"
        #Compare and swap (MeP-c5): Rl receives the memory value; memory gets Rn if the old
        #value of Rl equalled it, else Rl's new (loaded) value.
        #1111_nnnn_mmmm_0001 0010_llll_0000_0000
        :CASB3 wRl,Rn,RmMem is major=15 & sub=1 & Rn & RmMem; wop1215=2 & wRl & wop0407=0 & wop0003=0 {
            local old:4 = wRl;
            local m:1 = *:1 RmMem;
            wRl = zext(m);
            local st:1 = Rn:1 * zext(old == wRl) + m * zext(old != wRl);
            *:1 RmMem = st;
        }

        #1111_nnnn_mmmm_0001 0010_llll_0000_0001
        :CASH3 wRl,Rn,RmMem is major=15 & sub=1 & Rn & RmMem; wop1215=2 & wRl & wop0407=0 & wop0003=1 {
            local old:4 = wRl;
            local m:2 = *:2 RmMem;
            wRl = zext(m);
            local st:2 = Rn:2 * zext(old == wRl) + m * zext(old != wRl);
            *:2 RmMem = st;
        }

        #1111_nnnn_mmmm_0001 0010_llll_0000_0010
        :CASW3 wRl,Rn,RmMem is major=15 & sub=1 & Rn & RmMem; wop1215=2 & wRl & wop0407=0 & wop0003=2 {
            local old:4 = wRl;
            local m:4 = *:4 RmMem;
            wRl = m;
            local st:4 = Rn * zext(old == wRl) + m * zext(old != wRl);
            *:4 RmMem = st;
        }
@endif

@if (UCI_OPT == "1") && (NO_DEFAULT_UCI_INSTR == "0")
    #1111_nnnn_mmmm_0010 cccc_cccc_cccc_cccc
    #The operation is defined by the custom logic the core was built with.
    define pcodeop UserCustomInstruction;
    :UCI Rn,Rm,wimm16 is major=15 & sub=2 & Rn & Rm; wimm16 {
        Rn = UserCustomInstruction(Rn, Rm, wimm16:2);
    }
@endif

    #1111_iiii_mmmm_0011 dddd_dddd_dddd_dddd (MeP-c5)
    :PREF imm0811,RmDisp16 is (major=15 & sub=3 & imm0811) ... & RmDisp16 {
        CachePrefetch(imm0811:1, RmDisp16);
    }

    #1111_nnnn_0000_0100 aaaa_aaaa_aaaa_aaaa (abs16=aaaa_aaaa_aaaa_aaaa)
    :STCB Rn,CBusImm is major=15 & sub=4 & op0407=0 & Rn; CBusImm {
        CBusImm = Rn;
    }

    #1111_nnnn_0001_0100 aaaa_aaaa_aaaa_aaaa
    :LDCB Rn,CBusImm is major=15 & sub=4 & op0407=1 & Rn; CBusImm {
        Rn = CBusImm;
    }

@if (COP_OPT == "1")
    #Coprocessor loads and stores with post-increment (A), modulo-0 (M0) and modulo-1 (M1)
    #addressing:
    #1111_nnnn_mmmm_0101 oooo_MMdd_dddd_dddd  (o: size/direction, MM: 00 A, 10 M0, 11 M1)
    #Modulo addressing: if (Rm & mask) == MEn then Rm = (Rm & ~mask) | MBn, else Rm += disp,
    #where mask covers the bits up to the highest set bit of MBn | MEn.

        :SBCP^CopMode CRn,RmMemInc,CopInc is major=15 & sub=5 & CRn & RmMemInc & CRn32 & RmA; wop1215=0 & CopMode & CopInc {
            *:1 RmA = CRn32:1;
            cop_update(RmA, CopInc, CopMode);
        }
        :SHCP^CopMode CRn,RmMemInc,CopInc is major=15 & sub=5 & CRn & RmMemInc & CRn32 & RmA; wop1215=1 & CopMode & CopInc {
            *:2 RmA = CRn32:2;
            cop_update(RmA, CopInc, CopMode);
        }
        :SWCP^CopMode CRn,RmMemInc,CopInc is major=15 & sub=5 & CRn & RmMemInc & CRn32 & RmA; wop1215=2 & CopMode & CopInc {
            *:4 RmA = CRn32;
            cop_update(RmA, CopInc, CopMode);
        }
        :SMCP^CopMode CRn,RmMemInc,CopInc is major=15 & sub=5 & CRn & RmMemInc & RmA; wop1215=3 & CopMode & CopInc {
            *:8 RmA = CRn;
            cop_update(RmA, CopInc, CopMode);
        }
        :LBCP^CopMode CRn,RmMemInc,CopInc is major=15 & sub=5 & CRn & RmMemInc & CRn32 & RmA; wop1215=4 & CopMode & CopInc {
            CRn32 = sext(*:1 RmA);
            cop_update(RmA, CopInc, CopMode);
        }
        :LHCP^CopMode CRn,RmMemInc,CopInc is major=15 & sub=5 & CRn & RmMemInc & CRn32 & RmA; wop1215=5 & CopMode & CopInc {
            CRn32 = sext(*:2 RmA);
            cop_update(RmA, CopInc, CopMode);
        }
        :LWCP^CopMode CRn,RmMemInc,CopInc is major=15 & sub=5 & CRn & RmMemInc & CRn32 & RmA; wop1215=6 & CopMode & CopInc {
            CRn32 = *:4 RmA;
            cop_update(RmA, CopInc, CopMode);
        }
        :LMCP^CopMode CRn,RmMemInc,CopInc is major=15 & sub=5 & CRn & RmMemInc & RmA; wop1215=7 & CopMode & CopInc {
            CRn = *:8 RmA;
            cop_update(RmA, CopInc, CopMode);
        }
        #MeP-c5 zero-extending loads
        :LBUCP^CopMode CRn,RmMemInc,CopInc is major=15 & sub=5 & CRn & RmMemInc & CRn32 & RmA; wop1215=12 & CopMode & CopInc {
            CRn32 = zext(*:1 RmA);
            cop_update(RmA, CopInc, CopMode);
        }
        :LHUCP^CopMode CRn,RmMemInc,CopInc is major=15 & sub=5 & CRn & RmMemInc & CRn32 & RmA; wop1215=13 & CopMode & CopInc {
            CRn32 = zext(*:2 RmA);
            cop_update(RmA, CopInc, CopMode);
        }

        :SBCP CRn,wscd12^"("^RmA^")" is major=15 & sub=6 & CRn & CRn32 & RmA; wop1215=0 & wscd12 {
            local a:4 = RmA + wscd12;
            *:1 a = CRn32:1;
        }
        :SHCP CRn,wscd12^"("^RmA^")" is major=15 & sub=6 & CRn & CRn32 & RmA; wop1215=1 & wscd12 {
            local a:4 = RmA + wscd12;
            *:2 a = CRn32:2;
        }
        :LBCP CRn,wscd12^"("^RmA^")" is major=15 & sub=6 & CRn & CRn32 & RmA; wop1215=4 & wscd12 {
            local a:4 = RmA + wscd12;
            CRn32 = sext(*:1 a);
        }
        :LHCP CRn,wscd12^"("^RmA^")" is major=15 & sub=6 & CRn & CRn32 & RmA; wop1215=5 & wscd12 {
            local a:4 = RmA + wscd12;
            CRn32 = sext(*:2 a);
        }
        :LBUCP CRn,wscd12^"("^RmA^")" is major=15 & sub=6 & CRn & CRn32 & RmA; wop1215=12 & wscd12 {
            local a:4 = RmA + wscd12;
            CRn32 = zext(*:1 a);
        }
        :LHUCP CRn,wscd12^"("^RmA^")" is major=15 & sub=6 & CRn & CRn32 & RmA; wop1215=13 & wscd12 {
            local a:4 = RmA + wscd12;
            CRn32 = zext(*:2 a);
        }

    #1111_nnnn_mmmm_1100 dddd_dddd_dddd_dddd
    :SWCP CRn,RmDisp16 is (major=15 & sub=12 & CRn & CRn32) ... & RmDisp16 {
        *:4 RmDisp16 = CRn32;
    }

    #1111_nnnn_mmmm_1101 dddd_dddd_dddd_dddd
    :LWCP CRn,RmDisp16 is (major=15 & sub=13 & CRn & CRn32) ... & RmDisp16 {
        CRn32 = *:4 RmDisp16;
    }

    #1111_nnnn_mmmm_1110 dddd_dddd_dddd_dddd
    :SMCP CRn,RmDisp16 is (major=15 & sub=14 & CRn) ... & RmDisp16 {
        *:8 RmDisp16 = CRn;
    }

    #1111_nnnn_mmmm_1111 dddd_dddd_dddd_dddd
    :LMCP CRn,RmDisp16 is (major=15 & sub=15 & CRn) ... & RmDisp16 {
        CRn = *:8 RmDisp16;
    }
@endif #COP_OPT == 1

} #with :OM=0

@if IVC2_OPT == "1"
@include "ivc2.sinc"

#----------------------------------------------------------------------------------------------
# VLIW operation mode (IVC2: 64-bit bundles). Halfwords H0-H3:
#   V1 (H0 major < 12):        16-bit core instruction H0, P0S = H1:H2[15:12], P1 = H2[11:0]:H3
#   V3 (H0 = 1111_xxxx_xxxx_0111): P0 = H0[11:4]:H1:H2[15:12], P1 as V1
#   V2 (otherwise):            32-bit core instruction H0:H1, H2[15:12] unused, P1 as V1
# The slots execute in parallel; the coprocessor slots' semantics come first, so that a branch
# in the core slot (or the end of a repeat block) still lets them execute.
#----------------------------------------------------------------------------------------------

:^instruction^" + "^IVSlotP0S^" + "^IVSlotP1 is (OM=1 & major<12 ; ivt1_all ; ivt2_hi4 & ivt2_lo12 ; ivt3_all) & instruction & IVSlotP0S & IVSlotP1 [
	OM = 0; INVLIW = 1;
	IVA = (ivt1_all << 4) | ivt2_hi4;
	IVB = (ivt2_lo12 << 16) | ivt3_all;
] {
	build IVSlotP0S;
	build IVSlotP1;
	build instruction;
}

:^instruction^" + "^IVSlotP1 is (OM=1 & major>=12 ; ivt1_all ; ivt2_hi4 & ivt2_lo12 ; ivt3_all) & instruction & IVSlotP1 [
	OM = 0; INVLIW = 1;
	IVB = (ivt2_lo12 << 16) | ivt3_all;
] {
	build IVSlotP1;
	build instruction;
}

:^IVSlotP0^" + "^IVSlotP1 is (OM=1 & major=15 & sub=7 & op0811 & op0407 ; ivt1_all ; ivt2_hi4 & ivt2_lo12 ; ivt3_all) & IVSlotP0 & IVSlotP1 [
	IVA = (op0811 << 24) | (op0407 << 20) | (ivt1_all << 4) | ivt2_hi4;
	IVB = (ivt2_lo12 << 16) | ivt3_all;
] {
	build IVSlotP0;
	build IVSlotP1;
}
@endif
