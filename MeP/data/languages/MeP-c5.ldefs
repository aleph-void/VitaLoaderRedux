<!-- See Relax specification: Ghidra/Framework/SoftwareModeling/data/languages/language_definitions.rxg -->

<language_definitions>
   <language processor="MeP-c5"
            endian="little"
            size="32"
            variant="CMeP"
            version="1.0"
            slafile="CMeP.sla"
            processorspec="MeP-c5.pspec"
            id="MeP-c5:LE:32:CMeP">
    	<description>Toshiba MeP-c5 - CMeP implementation (PlayStation Vita; no coprocessor, UCI or DSP)</description>
    	<compiler name="default" spec="MeP-c5.cspec" id="default"/>
    	<external_name tool="gnu" name="mep"/>
    	<external_name tool="DWARF.register.mapping.file" name="MeP-c5.dwarf"/>
	</language>
   <language processor="MeP-c5"
            endian="little"
            size="32"
            variant="default"
            version="1.0"
            slafile="MeP-c5_le.sla"
            processorspec="MeP-c5.pspec"
            id="MeP-c5:LE:32:default">
    	<description>Toshiba MeP-c5/c4/h1, little-endian, all core options and coprocessor loads/stores</description>
    	<compiler name="default" spec="MeP-c5.cspec" id="default"/>
    	<external_name tool="gnu" name="mep"/>
    	<external_name tool="DWARF.register.mapping.file" name="MeP-c5.dwarf"/>
	</language>
   <language processor="MeP-c5"
            endian="big"
            size="32"
            variant="default"
            version="1.0"
            slafile="MeP-c5_be.sla"
            processorspec="MeP-c5.pspec"
            id="MeP-c5:BE:32:default">
    	<description>Toshiba MeP-c5/c4/h1, big-endian (GCC's default), all core options and coprocessor loads/stores</description>
    	<compiler name="default" spec="MeP-c5.cspec" id="default"/>
    	<external_name tool="gnu" name="mep"/>
    	<external_name tool="DWARF.register.mapping.file" name="MeP-c5.dwarf"/>
	</language>
   <language processor="MeP-c5"
            endian="little"
            size="32"
            variant="IVC2"
            version="1.0"
            slafile="MeP-c5_ivc2_le.sla"
            processorspec="MeP-c5.pspec"
            id="MeP-c5:LE:32:IVC2">
    	<description>Toshiba MeP-c5 with the IVC2 coprocessor (Venezia), little-endian: core options, IVC2 instructions, VLIW mode</description>
    	<compiler name="default" spec="MeP-c5.cspec" id="default"/>
    	<external_name tool="gnu" name="mep"/>
    	<external_name tool="DWARF.register.mapping.file" name="MeP-c5-ivc2.dwarf"/>
	</language>
   <language processor="MeP-c5"
            endian="big"
            size="32"
            variant="IVC2"
            version="1.0"
            slafile="MeP-c5_ivc2_be.sla"
            processorspec="MeP-c5.pspec"
            id="MeP-c5:BE:32:IVC2">
    	<description>Toshiba MeP-c5 with the IVC2 coprocessor (Venezia), big-endian: core options, IVC2 instructions, VLIW mode</description>
    	<compiler name="default" spec="MeP-c5.cspec" id="default"/>
    	<external_name tool="gnu" name="mep"/>
    	<external_name tool="DWARF.register.mapping.file" name="MeP-c5-ivc2.dwarf"/>
	</language>
