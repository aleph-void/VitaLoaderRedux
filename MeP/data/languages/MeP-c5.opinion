<opinions>
	<!-- EM_CYGNUS_MEP (0xF00D, signed -4083). e_flags bits 16-23 name the coprocessor
	     (EF_MEP_COP_*). Little-endian files without a coprocessor open with the CMeP language
	     (VitaLoader Redux's default, used for PlayStation Vita CMeP code); files with a
	     coprocessor, and big-endian files (GCC -meb), with MeP-c5:xx:32:default, which also
	     decodes the coprocessor, UCI and DSP instructions; files for the IVC2 coprocessor
	     (EF_MEP_COP_IVC2, GCC's default configuration) with MeP-c5:xx:32:IVC2.
	     Ghidra keeps only the preferred matches before it filters by byte order, so every
	     secondary-key case has a preferred entry for both byte orders. -->
	<constraint loader="Executable and Linking Format (ELF)" compilerSpecID="default">
		<constraint primary="-4083" secondary="0b........ 00000000 ........ ........" processor="MeP-c5" endian="little" size="32" variant="CMeP" preferred="true"/>
		<constraint primary="-4083" secondary="0b........ 00000110 ........ ........" processor="MeP-c5" endian="little" size="32" variant="IVC2" preferred="true"/>
		<constraint primary="-4083" secondary="0b........ 00000110 ........ ........" processor="MeP-c5" endian="big" size="32" variant="IVC2" preferred="true"/>
		<constraint primary="-4083" processor="MeP-c5" endian="little" size="32" variant="default"/>
		<constraint primary="-4083" secondary="0b........ 00000000 ........ ........" processor="MeP-c5" endian="big" size="32" variant="default" preferred="true"/>
		<constraint primary="-4083" processor="MeP-c5" endian="big" size="32" variant="default"/>
	</constraint>
</opinions>
